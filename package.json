{
  "name": "dsh-qq",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "把 QQ 接进 DeepSeek Harness：OneBot v11 接入、白名单、群聊 @、自动回复，带设置页。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "onebot",
    "napcat",
    "bot"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zy666946/dsh-qq.git"
  },
  "homepage": "https://github.com/zy666946/dsh-qq#readme",
